# --- Database ---
DATABASE_URL=postgresql+asyncpg://aether:password@localhost:5432/aether_cloud
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- GitHub App (official Aether app — private key lives here only) ---
GITHUB_APP_ID=
# base64-encoded RSA private key PEM:
# cat private-key.pem | base64 | tr -d '\n'
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# --- Admin API Key (protect this — grants license creation) ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Minimum 32 characters enforced at startup.
ADMIN_API_KEY=

# --- App ---
ENVIRONMENT=development
LOG_LEVEL=INFO
TOKEN_RATE_LIMIT_PER_MINUTE=60
